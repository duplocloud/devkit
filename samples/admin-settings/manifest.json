{
  "manifestVersion": "1.0",
  "id": "duplo.examples.adminsettings",
  "name": "Admin Settings",
  "version": "0.1.0",

  "sdkVersion": "REPLACED_BY_SKILL_FROM_sdk-version_ENDPOINT",
  "backend": {
    "assemblyDir": "duplo.examples.adminsettings/0.1.0/backend",
    "entryAssembly": "Duplo.Extension.AdminSettings.dll"
  },

  "resources": [
    {
      "ticketOriginType": "AdminSetting",
      "restSegment": "extensions/admin-settings",
      "subType": "admin-setting",
      "archetype": "typed",
      "entityType": "Duplo.Extension.AdminSettings.AdminSetting",
      "specType": "Duplo.Extension.AdminSettings.AdminSettingSpec",
      "resultType": "Duplo.Extension.AdminSettings.AdminSettingResult",
      "hooksType": "Duplo.Extension.AdminSettings.AdminSettingHooks",
      "serviceType": "Duplo.Extension.AdminSettings.AdminSettingService"
    }
  ],

  "skills": [
    { "folder": "duplo.examples.adminsettings/0.1.0/skills/provision-adminsetting", "isBuiltIn": true }
  ],
  "skillMappings": [
    { "originType": "AdminSetting", "subType": "admin-setting", "skillNames": ["provision-adminsetting"], "timeout": { "provision": 300, "deprovision": 120 } }
  ],

  "frontend": {
    "remote": {
      "remoteName": "duploExtensionAdminSettings",
      "remoteEntry": "/v1/aiservicedesk/extensions/duplo.examples.adminsettings/fe/remoteEntry.json",
      "exposedModule": "./Extension",
      "type": "module"
    },
    "menus": [
      {
        "id": "duplo.examples.adminsettings-platform-settings",
        "title": "Platform Settings",
        "type": "collapsible-section",
        "matIcon": "cog-outline",
        "scope": "admin",
        "children": [
          {
            "id": "duplo.examples.adminsettings-platform-settings-admin-settings",
            "title": "Admin Settings",
            "type": "item",
            "matIcon": "tune-variant",
            "relativeUrl": "extensions/admin-settings",
            "order": 40
          }
        ]
      }
    ],
    "routes": [
      { "path": "extensions/admin-settings", "resourceType": "AdminSetting", "subType": "admin-setting", "scope": "admin" }
    ]
  }
}
