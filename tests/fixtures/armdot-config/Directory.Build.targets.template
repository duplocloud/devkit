<Project>
  <!-- Dropped beside the extension csproj by scripts/build-extension.sh for the duration of one build, so the
       extension's own project file never changes. DuploDevkitBuildDir is the devkit's build/ directory.
       MSBuild imports only the nearest Directory.Build.targets, so this file would otherwise shadow one the extension
       or its repository keeps above backend/. The nearest one above is chained in first, unconditionally, since it
       applies to a plain build too. -->
  <PropertyGroup>
    <DuploParentBuildTargets>$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))</DuploParentBuildTargets>
  </PropertyGroup>
  <Import Project="$(DuploParentBuildTargets)" Condition="'$(DuploParentBuildTargets)' != ''" />
  <Import Project="$(DuploDevkitBuildDir)ArmDot.Obfuscation.targets" Condition="'$(DuploObfuscate)' == 'true'" />
</Project>
